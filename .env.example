# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: path to the DuckDB database file (defaults to in-memory if unset)
# DUCKDB_PATH=./research_assistant.duckdb

# Optional: override the primary model (default: meta-llama/llama-3.3-70b-instruct:free)
# PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: override the fallback model (default: google/gemini-2.0-flash-exp:free)
# FALLBACK_MODEL=google/gemini-2.0-flash-exp:free
